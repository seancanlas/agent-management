{
  "name": "example-agent",
  "version": "1.0.0",
  "description": "A simple example agent for testing the agent management system",
  "author": "Example Author",
  "license": "MIT",
  "homepage": "https://example.com/example-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/example-agent.git"
  },
  "keywords": [
    "agent",
    "example",
    "testing",
    "demo"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "example-agent": "cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.1.3",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "os": ["darwin", "linux"],
  "cpu": ["x64", "arm64"],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "agent.json",
    "cli.ts"
  ],
  "overrides": {
    "semver": "^7.5.2"
  },
  "optionalDependencies": {}
}